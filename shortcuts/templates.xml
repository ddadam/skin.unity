<?xml version="1.0" encoding="UTF-8"?>
<templates>

	<!-- Home screen submenu: one list per main menu item with a submenu, shown while that item has
		 focus. The items come from the combined submenu include, already filtered to the focused item. -->
	<submenu include="template-submenu" level="1">
		<controls>
			<control type="fixedlist" id="9901">
				<visible>String.IsEqual(Container(9000).ListItem.Property(name),$PROPERTY[name])</visible>
				<centerleft>50%</centerleft>
				<top>107</top>
				<width>1350</width>
				<height>60</height>
				<onup>9000</onup>
				<ondown>9002</ondown>
				<itemgap>0</itemgap>
				<focusposition>2</focusposition>
				<movement>2</movement>
				<orientation>Horizontal</orientation>
				<animation effect="slide" start="0,0" end="0,-97" time="200" tween="quadratic" easing="out">Hidden</animation>
				<animation effect="slide" start="0,0" end="-135,0" time="0" condition="String.IsEqual(Container(9901).NumItems,2) | String.IsEqual(Container(9901).NumItems,4)">conditional</animation>
				<animation effect="slide" start="0,-97" end="0,0" delay="250" time="200" tween="quadratic">Visible</animation>
				<itemlayout width="270" height="60">
					<control type="image">
						<height>60</height>
						<width>270</width>
						<texture colordiffuse="$INFO[Skin.String(color.tertiary)]">backgrounds/white.png</texture>
					</control>
					<control type="label">
						<height>60</height>
						<width>270</width>
						<align>center</align>
						<aligny>center</aligny>
						<font>button</font>
						<textcolor>$INFO[Skin.String(color.text)]</textcolor>
						<info>ListItem.Label</info>
					</control>
				</itemlayout>
				<focusedlayout width="270" height="60">
					<control type="image">
						<height>60</height>
						<width>270</width>
						<texture colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texture>
						<visible>Control.HasFocus(9901)</visible>
					</control>
					<control type="label">
						<height>60</height>
						<width>270</width>
						<align>center</align>
						<aligny>center</aligny>
						<font>button</font>
						<textcolor>white</textcolor>
						<info>ListItem.Label</info>
						<visible>Control.HasFocus(9901)</visible>
					</control>
					<control type="image">
						<height>60</height>
						<width>270</width>
						<texture colordiffuse="$INFO[Skin.String(color.tertiary)]">backgrounds/white.png</texture>
						<visible>!Control.HasFocus(9901)</visible>
					</control>
					<control type="label">
						<height>60</height>
						<width>270</width>
						<align>center</align>
						<aligny>center</aligny>
						<font>button</font>
						<textcolor>$INFO[Skin.String(color.text)]</textcolor>
						<info>ListItem.Label</info>
						<visible>!Control.HasFocus(9901)</visible>
					</control>
				</focusedlayout>
				<content>
					<include>skinshortcuts-mainmenu-submenu</include>
				</content>
			</control>
			<control type="group">
				<top>-4</top>
				<visible>String.IsEqual(Container(9000).ListItem.Property(name),$PROPERTY[name])</visible>
				<animation effect="slide" start="0,-97" end="0,0" delay="250" time="200" tween="quadratic">Visible</animation>
				<animation effect="slide" start="0,0" end="0,-97" time="200" tween="quadratic" easing="out">Hidden</animation>
				<include>HomeSubMenuArrows</include>
			</control>
		</controls>
	</submenu>

	<!-- Home screen widget for each main menu item that has one, in the layout from widgetLayout -->
	<template include="widget" menu="mainmenu">
		<condition>widgetPath</condition>
		<var name="layoutInclude">
			<value condition="widgetLayout=Poster">PosterWidget</value>
			<value condition="widgetLayout=Wide">WideWidget</value>
			<value condition="widgetLayout=Weather">WeatherWidget</value>
			<value>SquareWidget</value>
		</var>
		<var name="artwork">
			<value condition="widgetLayout=Wide">$VAR[HomeWidgetBannerVar]</value>
			<value>$VAR[HomeWidgetPosterVar]</value>
		</var>
		<var name="contentInclude">
			<value condition="widgetTarget=include">WidgetContentInclude</value>
			<value>WidgetContent</value>
		</var>
		<controls>
			<control type="group">
				<skinshortcuts>visibility</skinshortcuts>
				<include content="$PROPERTY[layoutInclude]">
					<param name="content" value="$PROPERTY[widgetPath]" />
					<param name="target" value="$PROPERTY[widgetTarget]" />
					<param name="contentInclude" value="$PROPERTY[contentInclude]" />
					<param name="list_id" value="8011$PROPERTY[index]" />
					<param name="artwork" value="$PROPERTY[artwork]" />
				</include>
			</control>
		</controls>
	</template>

</templates>
