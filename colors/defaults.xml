	<!-- Unity accent palette.
	     NOTE: these named definitions are inert fallbacks - the live colours
	     are inline $INFO[Skin.String(...)] lookups in xml/*.xml, resolved per
	     frame so picker/theme picks apply instantly. Kodi parses <color>
	     values as raw hex only and switches themes solely via its own GUI
	     setting (lookandfeel.colortheme); it never loads theme files based
	     on a skin string, so the bundled colors/<theme>.xml files stay
	     inactive until native integration lands. -->
	<color name="accent">FFE51C23</color>
	<color name="accent.dark">FF850A04</color>
	<color name="accent.light">FFE84E40</color>
	<color name="accent.alt">FFFFEB3B</color>
