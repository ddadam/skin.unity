<?xml version="1.0" encoding="UTF-8"?>
<!-- Versions / extras manager (Kodi 21+). One file for both windows:
     managevideoversions (info screen button 14, context menu "Manage versions")
     managevideoextras   (info screen button 15, context menu "Manage extras")
     Kodi sets the title (2), fills list 50 (the default version is the selected item) and
     drives the buttons (labels in list 50 need a selectedcolor: the default version is the
     selected item, and Kodi draws a selected item's labels in selectedcolor, transparent if
     unset): 21 play, 22 add version, 23 add extra, 24 choose type, 25 set as
     default, 26 remove, 27 choose art, 28 rename extra, 29 ungroup (Kodi 22). -->
<window type="dialog">
	<defaultcontrol always="true">50</defaultcontrol>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>1500</width>
			<animation effect="slide" start="1925,0" end="0,0" time="400" tween="quadratic" easing="out">WindowOpen</animation>
			<animation effect="slide" start="0,0" end="-1925,0" time="400" tween="quadratic" easing="out">WindowClose</animation>
			<include content="DynamicDialogBackground">
				<param name="dialog-width" value="1500" />
				<param name="glow-width" value="1580" />
				<param name="subtitle-visible" value="true" />
				<param name="subtitle-height" value="55" />
			</include>
			<!--close window button (mouse)-->
			<control type="button">
				<left>5</left>
				<top>0</top>
				<width>50</width>
				<height>25</height>
				<label></label>
				<font></font>
				<onclick>PreviousMenu</onclick>
				<texturefocus>DialogCloseButton-focus.png</texturefocus>
				<texturenofocus>DialogCloseButton.png</texturenofocus>
				<onleft>50</onleft>
				<onright>50</onright>
				<onup>50</onup>
				<ondown>50</ondown>
				<visible>system.getbool(input.enablemouse)</visible>
			</control>
			<!--title: "Versions Manager: <movie>" / "Extras Manager: <movie>"-->
			<control type="label" id="2">
				<left>45</left>
				<top>25</top>
				<width>1410</width>
				<height>60</height>
				<font>info.title</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
			</control>
			<!--focused file-->
			<control type="label">
				<left>45</left>
				<top>110</top>
				<width>1150</width>
				<height>52</height>
				<font>secondary.info.small</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[Container(50).ListItem.FileNameAndPath]</label>
			</control>
			<!--count-->
			<control type="label">
				<left>1210</left>
				<top>110</top>
				<width>250</width>
				<height>52</height>
				<font>button</font>
				<align>right</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[Container(50).NumItems] $LOCALIZE[31025]</label>
			</control>
			<!--poster of the focused version / extra (the movie's own art otherwise)-->
			<control type="image">
				<left>30</left>
				<top>190</top>
				<width>300</width>
				<height>450</height>
				<aspectratio aligny="top">keep</aspectratio>
				<fadetime>200</fadetime>
				<texture fallback="DefaultVideoCover.png" background="true">$INFO[Container(50).ListItem.Art(poster)]</texture>
				<visible>!String.IsEmpty(Container(50).ListItem.Art(poster))</visible>
			</control>
			<control type="image">
				<left>30</left>
				<top>190</top>
				<width>300</width>
				<height>450</height>
				<aspectratio aligny="top">keep</aspectratio>
				<fadetime>200</fadetime>
				<texture fallback="DefaultVideoCover.png" background="true">$INFO[Container(50).ListItem.Icon]</texture>
				<visible>String.IsEmpty(Container(50).ListItem.Art(poster))</visible>
			</control>
			<!--versions / extras-->
			<control type="list" id="50">
				<left>360</left>
				<top>190</top>
				<width>780</width>
				<bottom>30</bottom>
				<onup>50</onup>
				<ondown>50</ondown>
				<onleft>9001</onleft>
				<onright>9001</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime>200</scrolltime>
				<itemlayout height="105" width="780">
					<control type="image">
						<left>10</left>
						<top>8</top>
						<width>160</width>
						<height>90</height>
						<aspectratio>keep</aspectratio>
						<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>190</left>
						<top>12</top>
						<width>460</width>
						<height>40</height>
						<font>label</font>
						<aligny>center</aligny>
						<textcolor>$INFO[Skin.String(color.text)]</textcolor>
						<selectedcolor>$INFO[Skin.String(color.text)]</selectedcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>190</left>
						<top>52</top>
						<width>570</width>
						<height>40</height>
						<font>secondary.info.small</font>
						<aligny>center</aligny>
						<textcolor>$INFO[Skin.String(color.disabled)]</textcolor>
						<selectedcolor>$INFO[Skin.String(color.disabled)]</selectedcolor>
						<label>$INFO[ListItem.Duration]$INFO[ListItem.VideoResolution, • ,]$INFO[ListItem.VideoCodec, • ,]$INFO[ListItem.AudioCodec, • ,]$INFO[ListItem.AudioChannels, ,ch]</label>
					</control>
					<!--default version-->
					<control type="label">
						<right>20</right>
						<top>12</top>
						<width>200</width>
						<height>40</height>
						<font>button</font>
						<align>right</align>
						<aligny>center</aligny>
						<textcolor>$INFO[Skin.String(color.500)]</textcolor>
						<selectedcolor>$INFO[Skin.String(color.500)]</selectedcolor>
						<label>$LOCALIZE[571]</label>
						<visible>ListItem.IsSelected + Window.IsVisible(managevideoversions)</visible>
					</control>
				</itemlayout>
				<focusedlayout height="105" width="780">
					<control type="image">
						<width>780</width>
						<height>105</height>
						<texture colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texture>
						<animation effect="fade" start="100" end="50" time="200" condition="!Control.HasFocus(50)">Conditional</animation>
					</control>
					<control type="image">
						<left>10</left>
						<top>8</top>
						<width>160</width>
						<height>90</height>
						<aspectratio>keep</aspectratio>
						<texture fallback="DefaultVideo.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
					</control>
					<control type="label">
						<left>190</left>
						<top>12</top>
						<width>460</width>
						<height>40</height>
						<font>label</font>
						<aligny>center</aligny>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>190</left>
						<top>52</top>
						<width>570</width>
						<height>40</height>
						<font>secondary.info.small</font>
						<aligny>center</aligny>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<label>$INFO[ListItem.Duration]$INFO[ListItem.VideoResolution, • ,]$INFO[ListItem.VideoCodec, • ,]$INFO[ListItem.AudioCodec, • ,]$INFO[ListItem.AudioChannels, ,ch]</label>
					</control>
					<control type="label">
						<right>20</right>
						<top>12</top>
						<width>200</width>
						<height>40</height>
						<font>button</font>
						<align>right</align>
						<aligny>center</aligny>
						<textcolor>white</textcolor>
						<selectedcolor>white</selectedcolor>
						<label>$LOCALIZE[571]</label>
						<visible>ListItem.IsSelected + Window.IsVisible(managevideoversions)</visible>
					</control>
				</focusedlayout>
			</control>
			<control type="scrollbar" id="60">
				<left>1148</left>
				<top>190</top>
				<bottom>30</bottom>
				<orientation>vertical</orientation>
				<showonepage>false</showonepage>
				<onleft>50</onleft>
				<onright>9001</onright>
			</control>
			<!--actions: Kodi enables/disables them as the selection allows-->
			<control type="grouplist" id="9001">
				<left>1170</left>
				<top>190</top>
				<width>300</width>
				<bottom>30</bottom>
				<itemgap>5</itemgap>
				<onleft condition="Integer.IsGreater(Container(50).NumItems,0)">50</onleft>
				<onright condition="Integer.IsGreater(Container(50).NumItems,0)">50</onright>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<control type="button" id="21">
					<width>300</width>
					<label>208</label>
				</control>
				<control type="button" id="22">
					<width>300</width>
					<label>40014</label>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<control type="button" id="23">
					<width>300</width>
					<label>40015</label>
					<visible>Window.IsVisible(managevideoextras)</visible>
				</control>
				<control type="button" id="27">
					<width>300</width>
					<label>13511</label>
				</control>
				<control type="button" id="24">
					<width>300</width>
					<label>40004</label>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<control type="button" id="28">
					<width>300</width>
					<label>118</label>
					<visible>Window.IsVisible(managevideoextras)</visible>
				</control>
				<control type="button" id="25">
					<width>300</width>
					<label>40023</label>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<!--ungroup: Kodi 22 only (Kodi 21 has neither the action nor the label)-->
				<control type="button" id="29">
					<width>300</width>
					<label>40046</label>
					<visible>Window.IsVisible(managevideoversions) + !String.StartsWith(System.BuildVersionCode,21.)</visible>
				</control>
				<control type="button" id="26">
					<width>300</width>
					<label>15015</label>
				</control>
			</control>
		</control>
	</controls>
</window>
