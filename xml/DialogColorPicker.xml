<?xml version="1.0" encoding="UTF-8"?>
<!-- Colour picker (Kodi 20+): opened by colour settings, e.g. Settings > Player > Subtitles
     (expert level) and add-on settings. Kodi fills list 6 with named colours
     (ListItem.Label = name, ListItem.Label2 = AARRGGBB), sets the heading (1) and the
     cancel button (7), and starts on the current colour. -->
<window type="dialog">
	<defaultcontrol always="true">6</defaultcontrol>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>1210</width>
			<animation effect="slide" start="1925,0" end="0,0" time="400" tween="quadratic" easing="out">WindowOpen</animation>
			<animation effect="slide" start="0,0" end="-1925,0" time="400" tween="quadratic" easing="out">WindowClose</animation>
			<!--title bars and backgrounds-->
			<include content="DynamicDialogBackground">
				<param name="dialog-width" value="1210" />
				<param name="glow-width" value="1290" />
				<param name="subtitle-visible" value="true" />
				<param name="subtitle-height" value="55" />
			</include>
			<!--close window button (mouse)-->
			<control type="button">
				<left>5</left>
				<top>0</top>
				<width>50</width>
				<height>25</height>
				<label></label>
				<font></font>
				<onclick>PreviousMenu</onclick>
				<texturefocus>DialogCloseButton-focus.png</texturefocus>
				<texturenofocus>DialogCloseButton.png</texturenofocus>
				<onleft>6</onleft>
				<onright>6</onright>
				<onup>6</onup>
				<ondown>6</ondown>
				<visible>system.getbool(input.enablemouse)</visible>
			</control>
			<!--title-->
			<control type="label" id="1">
				<left>45</left>
				<top>25</top>
				<width>1120</width>
				<height>60</height>
				<font>info.title</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
			</control>
			<!--focused colour: name and hex value-->
			<control type="label">
				<left>45</left>
				<top>110</top>
				<width>800</width>
				<height>52</height>
				<font>button</font>
				<align>left</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[Container(6).ListItem.Label]$INFO[Container(6).ListItem.Label2,  [COLOR 80FFFFFF]#,[/COLOR]]</label>
			</control>
			<!--number of colours (not Kodi's id 2: the dialog base class blanks that)-->
			<control type="label">
				<left>860</left>
				<top>110</top>
				<width>325</width>
				<height>52</height>
				<font>button</font>
				<align>right</align>
				<aligny>center</aligny>
				<textcolor>white</textcolor>
				<label>$INFO[Container(6).NumItems] $LOCALIZE[31025]</label>
			</control>
			<!--colours: 12 per row-->
			<control type="panel" id="6">
				<left>30</left>
				<top>190</top>
				<width>1152</width>
				<bottom>86</bottom>
				<onup>6</onup>
				<ondown>90</ondown>
				<onleft>6</onleft>
				<onright>61</onright>
				<pagecontrol>61</pagecontrol>
				<scrolltime>200</scrolltime>
				<orientation>vertical</orientation>
				<itemlayout width="96" height="80">
					<control type="image">
						<left>8</left>
						<top>8</top>
						<width>80</width>
						<height>64</height>
						<texture>backgrounds/white.png</texture>
						<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
					</control>
					<!--hairline so pale colours stay visible on the light background-->
					<control type="image">
						<left>8</left>
						<top>8</top>
						<width>80</width>
						<height>64</height>
						<texture border="1" colordiffuse="20000000">colorbutton-outline.png</texture>
					</control>
				</itemlayout>
				<focusedlayout width="96" height="80">
					<!--focus frame-->
					<control type="image">
						<left>1</left>
						<top>1</top>
						<width>94</width>
						<height>78</height>
						<texture colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texture>
						<animation effect="fade" start="100" end="40" time="200" condition="!Control.HasFocus(6)">Conditional</animation>
					</control>
					<control type="image">
						<left>6</left>
						<top>6</top>
						<width>84</width>
						<height>68</height>
						<texture colordiffuse="$INFO[Skin.String(color.primary)]">backgrounds/white.png</texture>
					</control>
					<control type="image">
						<left>8</left>
						<top>8</top>
						<width>80</width>
						<height>64</height>
						<texture>backgrounds/white.png</texture>
						<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
					</control>
					<control type="image">
						<left>8</left>
						<top>8</top>
						<width>80</width>
						<height>64</height>
						<texture border="1" colordiffuse="20000000">colorbutton-outline.png</texture>
					</control>
				</focusedlayout>
			</control>
			<control type="scrollbar" id="61">
				<left>1193</left>
				<top>190</top>
				<bottom>93</bottom>
				<orientation>vertical</orientation>
				<showonepage>false</showonepage>
				<onleft>6</onleft>
				<onright>6</onright>
				<onup>61</onup>
				<ondown>61</ondown>
			</control>
			<!--buttons bar-->
			<control type="group">
				<control type="image">
					<centerleft>50%</centerleft>
					<top>65r</top>
					<width>1210</width>
					<height>70</height>
					<texture colordiffuse="$INFO[Skin.String(color.primary)]">backgrounds/white.png</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<top>65r</top>
					<width>1210</width>
					<height>10</height>
					<texture>homeshadow.png</texture>
					<animation effect="fade" start="100" end="75" time="0" condition="true">Conditional</animation>
				</control>
				<control type="grouplist" id="90">
					<centerleft>50%</centerleft>
					<top>65r</top>
					<width>200</width>
					<height>60</height>
					<orientation>horizontal</orientation>
					<align>center</align>
					<!--cancel (label set by Kodi)-->
					<include content="AnimatedCircleButtonGroup">
						<param name="button-id" value="7" />
						<param name="button-width" value="140" />
						<param name="button-texture" value="nobutton" />
						<param name="button-onup" value="6" />
						<param name="button-ondown" value="6" />
						<param name="button-onleft" value="7" />
						<param name="button-onright" value="7" />
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
