	<!-- a speed picked while paused: apply it once playback resumes -->
	<timer>
		<name>OSDPendingTempoApply</name>
		<start>!String.IsEmpty(Window(Home).Property(OSDPendingTempo)) + Player.HasVideo + !Player.Paused + !Player.Forwarding + !Player.Rewinding + String.IsEqual(Player.Filename,Window(Home).Property(OSDPendingFile))</start>
		<stop>![!String.IsEmpty(Window(Home).Property(OSDPendingTempo)) + Player.HasVideo + !Player.Paused + !Player.Forwarding + !Player.Rewinding + String.IsEqual(Player.Filename,Window(Home).Property(OSDPendingFile))]</stop>
		<onstart>PlayerControl(Tempo($INFO[Window(Home).Property(OSDPendingTempo)]))</onstart>
		<onstart>ClearProperty(OSDPendingTempo,home)</onstart>
		<onstart>ClearProperty(OSDPendingFile,home)</onstart>
	</timer>
	<!-- ...unless another file (or nothing) is playing by then -->
	<timer>
		<name>OSDPendingTempoDrop</name>
		<start>!String.IsEmpty(Window(Home).Property(OSDPendingTempo)) + !String.IsEqual(Player.Filename,Window(Home).Property(OSDPendingFile))</start>
		<stop>![!String.IsEmpty(Window(Home).Property(OSDPendingTempo)) + !String.IsEqual(Player.Filename,Window(Home).Property(OSDPendingFile))]</stop>
		<onstart>ClearProperty(OSDPendingTempo,home)</onstart>
		<onstart>ClearProperty(OSDPendingFile,home)</onstart>
	</timer>
	<!-- playback stopped -->
	<timer>
		<name>OSDTempoForget</name>
		<start>!Player.HasVideo + !String.IsEmpty(Window(Home).Property(OSDTempo))</start>
		<stop>![!Player.HasVideo + !String.IsEmpty(Window(Home).Property(OSDTempo))]</stop>
		<onstart>ClearProperty(OSDTempo,home)</onstart>
	</timer>
	<!-- mouse: the pointer moved on to something else while the menu was open -->
	<timer>
		<name>OSDSpeedMenuClose</name>
		<start>Window.IsActive(videoosd) + !String.IsEmpty(Window(videoosd).Property(SpeedMenuOpen)) + !Control.HasFocus(256) + !ControlGroup(580).HasFocus</start>
		<stop>![Window.IsActive(videoosd) + !String.IsEmpty(Window(videoosd).Property(SpeedMenuOpen)) + !Control.HasFocus(256) + !ControlGroup(580).HasFocus]</stop>
		<onstart>ClearProperty(SpeedMenuOpen,videoosd)</onstart>
	</timer>
