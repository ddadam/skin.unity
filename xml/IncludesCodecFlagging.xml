				<disabledcolor>$INFO[Skin.String(color.500)]</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturenofocus>
