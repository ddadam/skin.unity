	<include name="video.flags.info">
		<control type="grouplist" id="1">
			<width>680</width>
			<height>52</height>
			<itemgap>0</itemgap>
			<align>right</align>
			<orientation>horizontal</orientation>
			<visible>!Player.ChannelPreviewActive</visible>
			<!-- BEGIN generated: flag-row (tools/gen_flag_labels.py) -->
			<!-- Generated by tools/gen_flag_labels.py - edit the script, not this block.
			     Badges: [icon][7][text][7]; filled and outlined badges alternate. -->
			<!-- left cap: the row starts with an outlined badge when no frame rate is shown -->
			<control type="image" id="1">
				<width>1.4</width>
				<height>27</height>
				<texture>backgrounds/white.png</texture>
				<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				<visible>![$EXP[OSDFpsKnown]]</visible>
			</control>
			<!-- frame rate (filled): icon, number, then a tick on a matching display or "@ xx Hz" (tools/gen_fps_flags.py) -->
			<control type="group" id="1">
				<width>26</width>
				<height>27</height>
				<visible>$EXP[OSDFpsKnown]</visible>
				<control type="image" id="1">
					<width>26</width>
					<height>27</height>
					<texture>backgrounds/white.png</texture>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
				<control type="image" id="1">
					<left>5</left>
					<top>3</top>
					<width>21</width>
					<height>21</height>
					<texture>flags/icon_fps.png</texture>
					<aspectratio>keep</aspectratio>
					<colordiffuse>white</colordiffuse>
				</control>
			</control>
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$VAR[OSDFpsBadgeLabel]</label>
				<font>flag.text</font>
				<textcolor>white</textcolor>
				<disabledcolor>white</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturenofocus>
				<enable>false</enable>
				<visible>$EXP[OSDFpsKnown]</visible>
			</control>
			<control type="group" id="1">
				<width>24</width>
				<height>27</height>
				<visible>$EXP[OSDFpsKnown] + $EXP[OSDFpsMatch]</visible>
				<control type="image" id="1">
					<width>24</width>
					<height>27</height>
					<texture>backgrounds/white.png</texture>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
				<control type="image" id="1">
					<top>4</top>
					<width>19</width>
					<height>19</height>
					<texture>flags/fps_match.png</texture>
					<aspectratio>keep</aspectratio>
				</control>
			</control>
			<!-- resolution (outlined), with the HDR type when there is one: "4K HDR10" -->
			<control type="group" id="1">
				<width>26</width>
				<height>27</height>
				<visible>true</visible>
				<control type="image" id="1">
					<width>26</width>
					<height>27</height>
					<texture>flags/base 2.png</texture>
